 RowBox[{"sol", " ", "=", " ", 
  RowBox[{"NDSolveValue", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"f", "'"}], "[", "t", "]"}], " ", "==", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", " ", "0"}], "}"}]}], "}"}], " ", ".", 
        " ", 
        RowBox[{"f", "[", "t", "]"}]}]}], ",", " ", 
      RowBox[{
       RowBox[{"f", "[", "0", "]"}], " ", "==", " ", 
       RowBox[{"{", 
        RowBox[{"1.", ",", " ", "0."}], "}"}]}]}], "}"}], ",", " ", "f", ",", 
    " ", 
    RowBox[{"{", 
     RowBox[{"t", ",", " ", "0", ",", " ", "10"}], "}"}]}], "]"}]}]], "Input",\

