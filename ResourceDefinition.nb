}], "Subsection",
 Editable->False,
 Deletable->False,
 TaggingRules->{"TemplateGroupName" -> "Details"},
 DefaultNewCellStyle->"Notes",
 CellTags->{"Details", "TemplateCellGroup"},
 CellID->280804237,ExpressionUUID->"82751433-6e64-4d7a-bebc-6c9bab981ada"],

Cell[TextData[{
 "Every container of every tier answers ",
 Cell[BoxData[
  ButtonBox["ArrayDimensions",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/Arrays/ref/ArrayDimensions"]], "InlineFormula",
  ExpressionUUID->"5a335db4-87cf-4782-8bfc-3a10034fb773"],
 " and ",
 Cell[BoxData[
  ButtonBox["ArrayRank",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/Arrays/ref/ArrayRank"]], "InlineFormula",
  ExpressionUUID->"7b32678a-d105-412e-b35b-711fe54c4f1a"],
 " without materializing, and has an ",
 Cell[BoxData[
  ButtonBox["ArrayMaterialize",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/Arrays/ref/ArrayMaterialize"]], 
  "InlineFormula",ExpressionUUID->"6d91a397-4187-4b01-8069-34f1a3ea7c12"],
 " route."
}], "Notes",ExpressionUUID->"f297f8cf-db01-4153-9f3f-555bf4cc8d57"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["ArrayContainerQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/Arrays/ref/ArrayContainerQ"]], "InlineFormula",
  ExpressionUUID->"04e02575-fff1-468a-ae62-bd28d341de0c"],
 " is the top-level admission predicate, equivalent to ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"ArrayExplicitQ", "[", 
    StyleBox["a", "TI"], "]"}], " ", "||", " ", 
   RowBox[{"ArrayLazyQ", "[", 
    StyleBox["a", "TI"], "]"}], " ", "||", " ", 
   RowBox[{"ArraySymbolicQ", "[", 
    StyleBox["a", "TI"], "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c03a3a2d-51bc-4c38-8597-0c9d6fd76009"],
 "."
}], "Notes",ExpressionUUID->"acfd830d-a655-4349-8618-abbaec318c5a"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["ArrayComputeNativeQ",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/Arrays/ref/ArrayComputeNativeQ"]], 
  "InlineFormula",ExpressionUUID->"5c5dd0c7-2f70-4d17-bd83-efcab8f96fbc"],
 " is the capability flag, not an admission gate. ",
 Cell[BoxData[
  ButtonBox["SparseArray",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/SparseArray"]], "InlineFormula",ExpressionUUID->
  "eddf8f01-0d68-497a-8e6e-67aeba7145f9"],
 ", packed and plain lists, ",
 Cell[BoxData[
  ButtonBox["QuantityArray",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/QuantityArray"]], "InlineFormula",ExpressionUUID->
  "bcee1af5-bfee-4143-a05a-bdd05f6a12d3"],
 " and ",
 Cell[BoxData[
  ButtonBox["TabularColumn",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/TabularColumn"]], "InlineFormula",ExpressionUUID->
  "3bb4815a-29dd-4a69-a786-e3a3489c4405"],
 " are compute-native; ",
 Cell[BoxData[
  ButtonBox["NumericArray",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/NumericArray"]], "InlineFormula",ExpressionUUID->
  "588c632f-6136-4bb7-a2af-326dac64f234"],
 ", structured arrays and the remaining wrapper containers are storage-only, \
as are all lazy and symbolic containers."
}], "Notes",ExpressionUUID->"dd50317b-bcc1-4d5a-b4f1-71ff73c54c0e"],

Cell["\<\
A storage-only container is materialized before compute and re-wrapped in its \
own head where a reconstruction path exists.\
\>", "Notes",ExpressionUUID->"57a0f354-6c34-42da-aa5e-4fc7d63e0cad"],

Cell[TextData[{
 "Structural operations keep a lazy container lazy, and slice a symbolic \
container structurally: ",
 Cell[BoxData[
  ButtonBox["ArrayPart",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/Arrays/ref/ArrayPart"]], "InlineFormula",
  ExpressionUUID->"ce74c653-18d6-4f57-a2ff-73a4bcd4a935"],
 " of a ",
 Cell[BoxData[
  ButtonBox["MatrixSymbol",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/MatrixSymbol"]], "InlineFormula",ExpressionUUID->
  "d9554554-9dd7-4367-ad06-572a79bc7c2a"],
 " is a named ",
 Cell[BoxData[
  ButtonBox["VectorSymbol",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/VectorSymbol"]], "InlineFormula",ExpressionUUID->
  "63eedefc-f2ea-4074-96c7-340530729720"],
 "."
}], "Notes",ExpressionUUID->"f06f7797-7c2d-48f2-a26e-e0307d6ef9d3"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["ArrayReplaceAll",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/Arrays/ref/ArrayReplaceAll"]], "InlineFormula",
  ExpressionUUID->"1867f3a6-4df6-48e7-ad5d-1c0baf649291"],
 " substitutes into a lazy container as a whole, evaluating it a single time, \
where ",
 Cell[BoxData[
  ButtonBox["ArrayMaterialize",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/Arrays/ref/ArrayMaterialize"]], 
  "InlineFormula",ExpressionUUID->"cfbf8c9a-6a88-4750-9fdc-5732a5599c74"],
 " expands it into one inert application per element."
}], "Notes",ExpressionUUID->"31a8bdbd-e2b2-4260-b9e0-7ee6d21e3f0e"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["ArrayObject",
   BaseStyle->"Link",
   ButtonData->"paclet:Wolfram/Arrays/ref/ArrayObject"]], "InlineFormula",
  ExpressionUUID->"ebb226fe-a988-4b59-8046-380eaf6cf2d3"],
 " is a handle around any supported container, formatted as a summary box. \
Every function takes a handle wherever it takes a container, and gives back a \
raw container rather than another handle."
}], "Notes",ExpressionUUID->"24713f30-fc10-423d-81ef-2a64c1300e50"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["Association",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Association"]], "InlineFormula",ExpressionUUID->
  "1528ec85-b0f5-40ab-82d9-6d74ffe7f920"],
 " is not admitted: its ",
 Cell[BoxData[
  ButtonBox["Dimensions",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Dimensions"]], "InlineFormula",ExpressionUUID->
  "a569e08b-1fb9-4af3-9a22-40028ea05783"],
 " and ",
 Cell[BoxData[
  ButtonBox["Normal",
   BaseStyle->"Link",
   ButtonData->"paclet:ref/Normal"]], "InlineFormula",ExpressionUUID->
  "cfa370ad-4029-4ec6-be6b-409705f88032"],
 " report the entry multiset rather than the represented vector, so it has \
neither a faithful shape nor a faithful materialization."
}], "Notes",ExpressionUUID->"ecd3e97e-e7a8-4bb0-948c-2e2ab571179b"]
}, Open  ]],

